 "33": {
  "b1": {
   "kind": "code",
   "text": [
    "\"use server\"; // app/lancamentos/actions.ts",
    "export async function criarLancamento(_estado: Estado, form: FormData) {",
    "  const valor = Number(form.get(\"valor\"));",
    "  if (!valor || valor <= 0) return { erro: \"Informe um valor maior que zero.\" };",
    "  const db = await supabaseServer();",
    "  const { data: { user } } = await db.auth.getUser();",
    "  const { error } = await db.from(\"lancamentos\").insert({ user_id: user!.id,",
    "    valor, tipo: form.get(\"tipo\"), descricao: form.get(\"descricao\") });",
    "  if (error) return { erro: \"Nao consegui salvar. Tente de novo.\" };",
    "  revalidatePath(\"/lancamentos\");",
    "  redirect(\"/lancamentos\");",
    "}"
   ]
  }
 },
