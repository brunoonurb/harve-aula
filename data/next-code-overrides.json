    "import { supabaseServer } from \"@/lib/supabase-server\"; // app/(app)/dashboard/page.tsx",
    "export default async function Dashboard({ searchParams }: Props) {",
    "  const { mes = \"2025-06\" } = await searchParams;",
    "  const db = await supabaseServer();",
    "  const { data } = await db.from(\"lancamentos\").select(\"tipo, valor\")",
    "    .gte(\"data_lancamento\", `${mes}-01`).lte(\"data_lancamento\", `${mes}-30`);",
    "  const soma = (t: string) =>",
    "    (data ?? []).filter((l) => l.tipo === t).reduce((a, l) => a + Number(l.valor), 0);",
    "  return <Cards entradas={soma(\"entrada\")} saidas={soma(\"saida\")} mes={mes} />;",
    "}"
   ]
  }
 },
